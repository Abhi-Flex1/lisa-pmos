# Maintainer: Abhi <abhi@users.noreply.github.com>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=alsa-ucm-conf-lisa
pkgver=1
pkgrel=3
pkgdesc="ALSA UCM2 profiles for Xiaomi 11 Lite 5G NE (lisa)"
url="https://github.com/mainlining/alsa-ucm-conf"
# aarch64 (not noarch): sc7280-mainline's alsa-ucm-conf-qcom-sc7280 is
# aarch64-only, and pmbootstrap resolves a noarch aport's deps against noarch.
arch="aarch64"
license="MIT"
depends="alsa-ucm-conf-qcom-sc7280"
options="!check"
source="
	lisa.conf
	HiFi.conf
"

package() {
	_ucm="$pkgdir"/usr/share/alsa/ucm2

	install -Dm644 "$srcdir/lisa.conf" "$_ucm/Xiaomi/lisa/lisa.conf"
	install -Dm644 "$srcdir/HiFi.conf" "$_ucm/Xiaomi/lisa/HiFi.conf"

	# The snd-sm8250 machine driver sets driver_name="sm7325" and card
	# name="lisa" (from the sound node's model property in the DTS).
	# alsa-lib resolves UCM2 profiles via ucm2/conf.d/<driver>/<card>.
	install -d "$_ucm/conf.d/sm7325"
	ln -sf ../../Xiaomi/lisa/lisa.conf "$_ucm/conf.d/sm7325/lisa.conf"
}

sha512sums="
a3789d5d5af798b34793ad256fcbdd1d3a208169818b0c4333e451b99facacbfe673fc9866f906a3f7f0ff0e85180bb15ad574c3ddd0e4afb0436aad31ed67c4  lisa.conf
34347c3d066016afde4bf28534b580612771fa87c5aa1cfe9da5c1695c11519a281c8eea59c7fb8ad5d3566aade7930cb1a4c53a81ce8379cacc544234b274fa  HiFi.conf
"
