#!/bin/sh
# Camera /dev/media*, /dev/video* and /dev/v4l-subdev* are root:video 0660.
# Without this the user cannot open cameras, so plasma-camera and WirePlumber
# report no cameras at all even though libcamera enumerates all four sensors.
addgroup user video 2>/dev/null || true
addgroup user input 2>/dev/null || true

# PowerDevil generates desktop defaults on first boot on this device; force
# the mobile profile so the power key locks/toggles the screen, the display
# dims before turning off, and battery auto-suspend enters deep sleep.
if [ -f /etc/xdg/powerdevilrc ]; then
	install -d -o user -g user /home/user/.config 2>/dev/null || true
	install -o user -g user -m 644 /etc/xdg/powerdevilrc \
		/home/user/.config/powerdevilrc 2>/dev/null || true
fi

# Per-orientation status bar punch-hole padding (portrait top-left, landscape top-right).
if [ -f /etc/xdg/plasma-mobile/plasmamobilerc ]; then
	install -d -o user -g user /home/user/.config/plasma-mobile 2>/dev/null || true
	install -o user -g user -m 644 /etc/xdg/plasma-mobile/plasmamobilerc \
		/home/user/.config/plasma-mobile/plasmamobilerc 2>/dev/null || true
fi

# Enable boot services (5 GHz regdomain + power tuning / touch recovery).
systemctl enable lisa-regdomain.service 2>/dev/null || true
systemctl enable lisa-power-tune.service 2>/dev/null || true

# Qualcomm Q6AFE/Q6ASM (snd_soc_sm8250) requires interrupt-driven ALSA
# scheduling (tsched=0) locked at 48 kHz with clean resampling (soxr-mq) and
# 4x25ms fragments so low-rate / QtMultimedia apps (kclock, krecorder) never
# glitch or underrun.
if [ -f /etc/pulse/default.pa ]; then
	sed -i 's/^load-module module-udev-detect$/load-module module-udev-detect tsched=0/' /etc/pulse/default.pa
fi
set_pulse_opt() {
	key="$1"; val="$2"; f="/etc/pulse/daemon.conf"
	[ -f "$f" ] || return 0
	if grep -q "^${key}[[:space:]]*=" "$f"; then
		sed -i "s/^${key}[[:space:]]*=.*/${key} = ${val}/" "$f"
	else
		echo "${key} = ${val}" >> "$f"
	fi
}
set_pulse_opt default-sample-rate 48000
set_pulse_opt alternate-sample-rate 48000
set_pulse_opt avoid-resampling no
set_pulse_opt resample-method soxr-mq
set_pulse_opt default-fragments 4
set_pulse_opt default-fragment-size-msec 25
exit 0
