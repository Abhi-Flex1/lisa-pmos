# Maintainer: Jens Reidel <adrian@travitia.xyz>
# Reference: <https://postmarketos.org/devicepkg>

pkgname=device-xiaomi-lisa
pkgdesc="Xiaomi 11 Lite 5G NE / 11 LE"
pkgver=1
pkgrel=11
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
install="$pkgname.post-install $pkgname.post-upgrade"
# Xwayland is required: without it kwin_wayland's --xwayland fails and any
# Qt app launched with DISPLAY=:0 (plasma-camera, krunner, ...) hangs forever
# trying to connect to a non-existent X server.
depends="
	alsa-ucm-conf-qcom-sc7280
	alsa-ucm-conf-lisa
	firmware-xiaomi-lisa-adsp
	firmware-xiaomi-lisa-cdsp
	firmware-xiaomi-lisa-gpu
	firmware-xiaomi-lisa-ipa
	firmware-xiaomi-lisa-modem
	firmware-xiaomi-lisa-sensors
	firmware-xiaomi-lisa-vpu
	firmware-xiaomi-lisa-wpss
	firmware-qcom-adreno-a660
	hexagonrpcd>=0.3.2-r3
	linux-firmware-ath11k
	linux-firmware-qca
	iw
	wireless-regdb
	linux-postmarketos-qcom-sc7280
	make-dynpart-mappings
	mkbootimg
	android-tools
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
	unl0kr-fbforcerefresh
	xwayland
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	99-powerdevil-no-ddcutil.conf
	99-pulseaudio-no-x11.conf
	xiaomi-lisa-modules.conf
	73-xiaomi-lisa-haptics.rules
	50-lisa-cameras.conf
	50-lisa-camera-perms.rules
	powerdevilrc
	10-lisa-power.conf
	lisa-regdomain.service
	lisa-regdomain
	50-lisa-input-perms.rules
	50-lisa.preset
	99-lisa-printk.conf
	xiaomi-lisa-preset.conf
	81-libssc-xiaomi-lisa.rules
	plasmamobilerc
	lisa-power-tune.service
	10-lisa-sensorspd.conf
"

build() {
	devicepkg_build $startdir $pkgname

	# Zeroed dtbo.img causes Xiaomi lisa's ABL GetDtboNeeded() to return false,
	# bypassing Gunyah hyp DTBO ufdt_apply_overlay (which fails on mainline DTBs)
	# and booting directly via the single-appended-DTB path.
	dd if=/dev/zero of="$srcdir/dtbo.img" bs=16777216 count=1
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
	install -Dm644 "$srcdir/99-powerdevil-no-ddcutil.conf" \
		"$pkgdir/etc/systemd/user/plasma-powerdevil.service.d/99-no-ddcutil.conf"
	install -Dm644 "$srcdir/99-pulseaudio-no-x11.conf" \
		"$pkgdir/etc/systemd/user/app-pulseaudio@autostart.service.d/99-no-x11.conf"
	install -Dm644 "$srcdir/xiaomi-lisa-modules.conf" \
		"$pkgdir/etc/modules-load.d/xiaomi-lisa.conf"
	install -Dm644 "$srcdir/73-xiaomi-lisa-haptics.rules" \
		"$pkgdir/etc/udev/rules.d/73-xiaomi-lisa-haptics.rules"
	install -Dm644 "$srcdir/50-lisa-cameras.conf" \
		"$pkgdir/etc/wireplumber/wireplumber.conf.d/50-lisa-cameras.conf"
	install -Dm644 "$srcdir/50-lisa-camera-perms.rules" \
		"$pkgdir/etc/udev/rules.d/50-lisa-camera-perms.rules"
	install -Dm644 "$srcdir/powerdevilrc" "$pkgdir/etc/xdg/powerdevilrc"
	install -Dm644 "$srcdir/10-lisa-power.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/10-lisa-power.conf"
	install -Dm644 "$srcdir/lisa-regdomain.service" \
		"$pkgdir/usr/lib/systemd/system/lisa-regdomain.service"
	install -Dm644 "$srcdir/lisa-regdomain" "$pkgdir/etc/lisa-regdomain"
	install -Dm644 "$srcdir/50-lisa-input-perms.rules" \
		"$pkgdir/etc/udev/rules.d/50-lisa-input-perms.rules"
	install -Dm644 "$srcdir/50-lisa.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/50-lisa.preset"
	install -Dm644 "$srcdir/99-lisa-printk.conf" \
		"$pkgdir/etc/sysctl.d/99-lisa-printk.conf"
	install -Dm644 "$srcdir/xiaomi-lisa-preset.conf" \
		"$pkgdir/usr/share/plasma-mobile-device-presets/xiaomi,lisa.conf"
	install -Dm644 "$srcdir/81-libssc-xiaomi-lisa.rules" \
		"$pkgdir/etc/udev/rules.d/81-libssc-xiaomi-lisa.rules"
	install -Dm644 "$srcdir/plasmamobilerc" \
		"$pkgdir/etc/xdg/plasma-mobile/plasmamobilerc"
	install -Dm644 "$srcdir/lisa-power-tune.service" \
		"$pkgdir/usr/lib/systemd/system/lisa-power-tune.service"
	install -Dm644 "$srcdir/10-lisa-sensorspd.conf" \
		"$pkgdir/etc/systemd/system/iio-sensor-proxy.service.d/10-lisa-sensorspd.conf"
}

